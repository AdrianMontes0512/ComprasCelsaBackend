# ============================================================
# COMPRAS CELSA BACKEND — Plantilla de variables de entorno
# Copia este archivo a `.env` y completa los valores reales.
# `.env` está en .gitignore — NUNCA lo subas a git.
# ============================================================

# ---- Base de datos ----
# Local (con docker-compose):
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Cloud Run con Cloud SQL (NO setear estas dos en local):
# INSTANCE_CONNECTION_NAME=PROJECT:REGION:INSTANCE
# DB_NAME=celsa
#
# Cuando INSTANCE_CONNECTION_NAME está seteado, Spring Cloud GCP arma la
# DataSource automáticamente hacia Cloud SQL. spring.datasource.url se ignora.

# ---- JWT ----
# Generar nuevo: openssl rand -hex 32
JWT_SECRET=545335351d1bfaad5204c6245a5d917740a9d9568d2f4747b63ea84fa89b0ba2

# ---- Mail (Gmail SMTP) ----
# La app password se genera en https://myaccount.google.com/apppasswords
# (cuenta con 2FA activado; 16 caracteres con espacios opcionales)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sistemcomprascelsa@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ---- JPA ----
# update: crea/altera tablas automáticamente. Para producción considera 'validate'.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ---- Server ----
# Cloud Run inyecta PORT automáticamente. Local: dejar vacío (default 8080).
# PORT=8080
